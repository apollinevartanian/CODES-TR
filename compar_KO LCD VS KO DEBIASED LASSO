#  2. FONCTIONS DE SIMULATION ET MÉTRIQUES 

beta.sample <- function(p, k, amplitude){ 
  nonzero <- sample(p, k); beta <- rep(0, p)
  beta[nonzero] <- amplitude * sample(c(1, -1), k, replace = TRUE) 
  return(beta) 
}

y.sample <- function(X, beta, threshold = 0.5){ 
  y_prob <- 1 / (1 + exp(- (scale(X) %*% beta))) 
  return(as.numeric(y_prob >= threshold))
}

fdp_calc <- function(selected, beta_coeff) {
  if (length(selected) == 0) return(0)
  return(sum(beta_coeff[selected] == 0) / length(selected))
}

power_calc <- function(selected, beta_coeff) {
  if (sum(beta_coeff != 0) == 0) return(0)
  return(length(which(beta_coeff[selected] != 0)) / length(which(beta_coeff != 0)))
}

#  3. GÉNÉRATION DES KNOCKOFFS LSCIP 

create.LSCIP_parallel <- function(X) {
  p <- ncol(X); n <- nrow(X)
  ncores <- parallel::detectCores() - 1
  cl <- parallel::makeCluster(ncores); doParallel::registerDoParallel(cl)
  result <- foreach(j = 1:p, .packages = c("glmnet")) %dopar% {
    y = X[, j]; X_ = X[, -j]
    modelj <- glmnet::cv.glmnet(X_, y); betaj <- as.matrix(coef(modelj, s = "lambda.min"))
    X_j <- cbind(rep(1, n), X_); residuals_j = y - X_j %*% betaj
    lasso_x_j = X_j %*% betaj
    list(residuals_j, lasso_x_j)
  }
  parallel::stopCluster(cl)
  mat_residuals <- sapply(result, `[[`, 1); mat_lasso_x <- sapply(result, `[[`, 2)
  return(mat_lasso_x + mat_residuals[, sample(p)]) 
}

#  4. STATISTIQUE KO DEBIASED LASSO 

stat.ko_debiased <- function(X, X_ko, y) {
  X_aug <- scale(cbind(X, X_ko))
  nn <- length(y); pp_aug <- ncol(X_aug)
  p_orig <- pp_aug / 2
  
  # Lasso sur matrice augmentée
  cvobj <- cv.glmnet(x=X_aug, y=y, family="binomial", standardize=F, intercept=T)
  beta_lasso <- as.vector(coef(glmnet(x=X_aug, y=y, family="binomial", standardize=F, intercept=T), s=cvobj$lambda.min))
  
  X_int <- cbind(1, X_aug)
  mu <- as.vector(exp(X_int %*% beta_lasso)/(1 + exp(X_int %*% beta_lasso)))
  neg_dloglik <- -as.vector(t(X_int) %*% (y - mu)) / nn
  neg_ddloglik <- t(X_int) %*% diag(mu * (1 - mu)) %*% X_int / nn
  C_mat <- sqrt(diag(mu * (1 - mu)) / nn) %*% X_int
  
  # Nodewise Lasso pour Theta 
  theta_mat <- diag(pp_aug + 1)
  tau_vec <- rep(NA, pp_aug + 1)
  for(j in 1:(pp_aug + 1)) {
    cur_x <- sqrt(nn) * C_mat[, -j]; cur_y <- sqrt(nn) * as.vector(C_mat[, j])
    fit_node <- glmnet(x=cur_x, y=cur_y, family="gaussian", alpha=1, standardize=F, intercept=F, lambda = 0.01)
    gamma_j <- as.vector(fit_node$beta)
    theta_mat[j, -j] <- -gamma_j
    tau_vec[j] <- as.numeric(neg_ddloglik[j, j] - neg_ddloglik[j, -j] %*% gamma_j)
  }
  theta_mat <- diag(1 / tau_vec) %*% theta_mat 
  
  # Coefficients débiaisés et stat W
  b_deb <- as.vector(beta_lasso - theta_mat %*% neg_dloglik)
  b_deb <- b_deb[-1] 
  W <- abs(b_deb[1:p_orig]) - abs(b_deb[(p_orig+1):pp_aug])
  return(W)
}

#  5. FONCTION DE MISE EN FORME

df_perf_maker <- function(table.perf, list_fdr, stats_names, n.rep){
  n.stats <- length(stats_names); len_fdr <- length(list_fdr)
  df_p <- data.frame(power=NA, target_fdr=rep(list_fdr, n.stats), std=NA, Method=rep(stats_names, each=len_fdr))
  df_f <- data.frame(fdp=NA, target_fdr=rep(list_fdr, n.stats), std=NA, Method=rep(stats_names, each=len_fdr))
  raw_list <- list()
  
  for (i in 1:n.stats){
    list_FDP_perf <- as.numeric(table.perf[1, seq(i, ncol(table.perf), n.stats)])
    list_power_perf <- as.numeric(table.perf[2, seq(i, ncol(table.perf), n.stats)])
    raw_list[[stats_names[i]]] <- data.frame(fdp = list_FDP_perf, power = list_power_perf)
    for (j in 1:len_fdr){
      idx_range <- seq(j, length(list_power_perf), len_fdr)
      df_p$power[(i-1)*len_fdr + j] <- mean(list_power_perf[idx_range], na.rm=T)
      df_f$fdp[(i-1)*len_fdr + j]   <- mean(list_FDP_perf[idx_range], na.rm=T)
      df_p$std[(i-1)*len_fdr + j]   <- sd(list_power_perf[idx_range], na.rm=T) 
      df_f$std[(i-1)*len_fdr + j]   <- sd(list_FDP_perf[idx_range], na.rm=T)
    }
  }
  
  fdp_grid <- seq(0, 1, length.out = 100); df_g3_final <- data.frame()
  for (name in stats_names) {
    d <- raw_list[[name]]
    interp_matrix <- sapply(1:n.rep, function(r) {
      idx <- ((r-1)*len_fdr + 1):(r*len_fdr)
      x_vals <- d$fdp[idx]; y_vals <- d$power[idx]
      if(length(unique(x_vals)) < 2) return(rep(mean(y_vals), length(fdp_grid)))
      approx(x_vals, y_vals, xout = fdp_grid, rule = 2, ties = mean)$y
    })
    df_g3_final <- rbind(df_g3_final, data.frame(
      fdp = fdp_grid, power = rowMeans(interp_matrix, na.rm = TRUE),
      std = apply(interp_matrix, 1, sd, na.rm = TRUE), Method = name
    ))
  }
  return(list(df_p, df_f, df_g3_final))
}

#  6. BOUCLE DE SIMULATION 

cat("Génération des Knockoffs LSCIP...\n")
X_ko_lscip <- create.LSCIP_parallel(X_real)

table.perf.comp <- matrix(0, nrow = 2, ncol = length(list_target_fdr) * 2 * n_sim)

for (i in 1:n_sim) {
  cat("Simulation n°", i, "/", n_sim, "\n")
  current_beta <- beta.sample(p, k_exp, amplitude_exp)
  y_curr <- y.sample(X_real, current_beta)
  
  # Calcul des statistiques W
  stat_lcd <- stat.glmnet_coefdiff(X_real, X_ko_lscip, y_curr, family = "binomial")
  stat_deb <- stat.ko_debiased(X_real, X_ko_lscip, y_curr)
  
  for (j in 1:length(list_target_fdr)) {
    q <- list_target_fdr[j]
    
    sel_lcd <- which(stat_lcd >= knockoff.threshold(stat_lcd, fdr = q))
    sel_deb <- which(stat_deb >= knockoff.threshold(stat_deb, fdr = q))
    
    col_idx_lcd <- (i-1)*length(list_target_fdr)*2 + (j-1)*2 + 1
    col_idx_deb <- (i-1)*length(list_target_fdr)*2 + (j-1)*2 + 2
    
    table.perf.comp[1, col_idx_lcd] <- fdp_calc(sel_lcd, current_beta)
    table.perf.comp[2, col_idx_lcd] <- power_calc(sel_lcd, current_beta)
    table.perf.comp[1, col_idx_deb] <- fdp_calc(sel_deb, current_beta)
    table.perf.comp[2, col_idx_deb] <- power_calc(sel_deb, current_beta)
  }
}

# 7. GÉNÉRATION DES GRAPHES

res_dfs <- df_perf_maker(table.perf.comp, list_target_fdr, c("KO LCD", "KO Debiased"), n_sim)
