#  2. FONCTION  : LSCIP 
#génère des Knockoffs 
create.LSCIP_M_times <- function(X, M = 1){
  p <- ncol(X); n <- nrow(X)
  mat_residuals <- matrix(nrow = n, ncol = p)
  mat_lasso_x <- matrix(nrow = n, ncol = p)
  
  # Gestion des coeurs pour le calcul parallèle
  ncores <- as.numeric(Sys.getenv("SLURM_CPUS_PER_TASK"))
  if (is.na(ncores) || ncores == 0) { ncores <- parallel::detectCores() }
  
  cluster <- makeCluster(ncores - 1)
  registerDoParallel(cluster)
  
  result <- foreach(j = 1:p, .packages = c("glmnet")) %dopar% {
    X_ <- X[,-j] |> as.matrix()
    Xj <- X[, j]
    modelj <- cv.glmnet(X_, Xj)
    Xj_hat <- predict(modelj, s = modelj$lambda.min, newx = X_)
    list(Xj - Xj_hat, Xj_hat)
  }
  stopCluster(cl = cluster)
  
  for (j in 1:p) {
    mat_residuals[, j] <- result[[j]][[1]]
    mat_lasso_x[, j]   <- result[[j]][[2]]
  }
  
  list_KO <- list()
  for (m in 1:M){
    mat_shuffled_residuals <- apply(mat_residuals, 2, function(col) sample(col, replace = FALSE))
    X_KO <- mat_lasso_x + mat_shuffled_residuals 
    list_KO[[m]] <- X_KO |> as.data.frame()
  }
  if (M == 1){ return(as.matrix(list_KO[[1]])) } else { return(list_KO) }
}

