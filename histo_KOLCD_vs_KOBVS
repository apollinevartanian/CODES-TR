# COMPARISON: BVS+KO VS LCD+KO 

rm(list = ls()) 
set.seed(123) 

library(ggplot2)
library(varbvs)
library(glmnet)
library(doParallel)
library(foreach)
library(dplyr)
library(tidyr)
library(ggpubr)
library(knockoff)

# 1. PARAMÈTRES ET DONNÉES
chemin_fichier <- "C:/Users/axelC/Downloads/TRSANTEApo/dat_vst_NS_no_Inel_selected.txt"
if (!file.exists(chemin_fichier)) stop("Fichier introuvable.")

RNA.data <- read.table(file = chemin_fichier, head = TRUE) 
X_real <- as.matrix(RNA.data)
n <- nrow(X_real); p <- ncol(X_real)

# CONFIGURATION
n_sim <- 100         
k_exp <- 10          
amplitude_exp <- 3   
list_target_fdr <- seq(0.01, 1, length.out = 30) 

# 2. FONCTIONS DE SIMULATION ET CALCULS
beta.sample <- function(p, k, amplitude){ 
  nonzero <- sample(p, k); beta <- rep(0, p)
  beta[nonzero] <- amplitude * sample(c(1, -1), k, replace = TRUE) 
  return(beta) 
}

y.sample <- function(X, beta, method, scale = FALSE, threshold = 0.5){ 
  if (scale == TRUE){X = scale(X)}
  if (method == "linear"){ 
    y_prob <- 1 / (1 + exp(- (X%*%beta))) 
    y <- 1*(y_prob>=threshold) 
  }
  return(y)
}

fdp_calc <- function(selected, beta_coeff) {
  return(sum(beta_coeff[selected] == 0) / max(1, length(selected)))
}

power_calc <- function(selected, beta_coeff) {
  return(length(which(beta_coeff[selected] != 0)) / max(1, length(which(beta_coeff != 0))))
}

create.LSCIP_parallel <- function(X) {
  p <- ncol(X); n <- nrow(X)
  ncores <- parallel::detectCores() - 1
  cl <- parallel::makeCluster(ncores); doParallel::registerDoParallel(cl)
  result <- foreach(j = 1:p, .packages = c("glmnet")) %dopar% {
    y = X[, j]; X_ = X[, -j]
    modelj <- cv.glmnet(X_, y); betaj <- as.matrix(coef(modelj, s = "lambda.min"))
    X_j <- cbind(rep(1, n), X_); residuals_j = y - X_j %*% betaj
    lasso_x_j = X_j %*% betaj
    list(residuals_j, lasso_x_j)
  }
  parallel::stopCluster(cl)
  mat_residuals <- sapply(result, `[[`, 1); mat_lasso_x <- sapply(result, `[[`, 2)
  return(mat_lasso_x + mat_residuals[, sample(p)]) 
}

# 3. FONCTION DE MISE EN FORME
df_perf_maker_by_fdp_bins <- function(table.perf, stats_names, n_bins = 10){
  df_raw <- data.frame(
    fdp = as.numeric(table.perf[1,]), 
    power = as.numeric(table.perf[2,]),
    Method = rep(stats_names, length.out = ncol(table.perf))
  )
  
  df_summarized <- df_raw %>%
    group_by(Method) %>%
    mutate(fdp_bin = cut(fdp, breaks = seq(0, 1, length.out = n_bins + 1), 
                         include.lowest = TRUE, labels = FALSE)) %>%
    group_by(Method, fdp_bin) %>%
    summarise(
      mean_fdp = mean(fdp),
      mean_power = mean(power),
      sd_power = sd(power),
      .groups = "drop"
    ) %>%
    filter(!is.na(mean_power)) 
  
  return(list(df_summarized, df_raw))
}

# 4. BOUCLE DE SIMULATION
cat("Calcul des Knockoffs LSCIP...\n")
X_ko <- create.LSCIP_parallel(X_real)
table.perf.comp <- matrix(0, nrow = 2, ncol = length(list_target_fdr) * 2 * n_sim)

for (i in 1:n_sim) {
  cat("Simulation n°", i, "/", n_sim, "\r")
  current_beta <- beta.sample(p, k_exp, amplitude_exp)
  y_curr <- y.sample(X_real, current_beta, method = "linear", scale = TRUE)
  
  # Calcul Statistiques BVS+KO
  fit_ko <- varbvs(X = scale(cbind(X_real, X_ko)), Z = NULL, y = as.numeric(y_curr), family = "binomial", verbose = FALSE)
  stat_bvs_ko <- fit_ko$pip[1:p] - fit_ko$pip[(p+1):(2*p)]
  
  # Calcul Statistiques LCD+KO
  stat_lcd_ko <- stat.glmnet_coefdiff(X_real, X_ko, as.numeric(y_curr), family = "binomial")
  
  for (j in 1:length(list_target_fdr)) {
    q <- list_target_fdr[j]
    
    thres_bvs <- knockoff.threshold(stat_bvs_ko, fdr = q, offset = 1); sel_bvs <- which(stat_bvs_ko >= thres_bvs)
    thres_lcd <- knockoff.threshold(stat_lcd_ko, fdr = q, offset = 1); sel_lcd <- which(stat_lcd_ko >= thres_lcd)
    
    col_idx_bvs <- (i-1)*length(list_target_fdr)*2 + (j-1)*2 + 1
    col_idx_lcd <- (i-1)*length(list_target_fdr)*2 + (j-1)*2 + 2
    
    table.perf.comp[1, col_idx_bvs] <- fdp_calc(sel_bvs, current_beta)
    table.perf.comp[2, col_idx_bvs] <- power_calc(sel_bvs, current_beta)
    table.perf.comp[1, col_idx_lcd] <- fdp_calc(sel_lcd, current_beta)
    table.perf.comp[2, col_idx_lcd] <- power_calc(sel_lcd, current_beta)
  }
}

# 5. GÉNÉRATION DU GRAPHE
res_dfs <- df_perf_maker_by_fdp_bins(table.perf.comp, c("BVS+KO", "LCD+KO"), n_bins = 10)
df_bins <- res_dfs[[1]]; df_raw <- res_dfs[[2]]
colors_paper <- c("BVS+KO" = "#6050dc", "LCD+KO" = "#009E73")

# Graphe A : Histogramme (position = "dodge" pour barres côte à côte)
g_hist <- ggplot(df_raw, aes(x = fdp, fill = Method)) +
  geom_histogram(bins = 10, position = "dodge", alpha = 1, color = "white") +
  scale_fill_manual(values = colors_paper) +
  labs(title = paste(" "), x = "", y = "Count") +
  theme_minimal() +
  theme(axis.text.x = element_blank(), axis.ticks.x = element_blank())

# Graphe B : Courbe Puissance vs FDP (Points réduits à 1.5)
g_main <- ggplot(df_bins, aes(x = mean_fdp, y = mean_power, color = Method, fill = Method)) +
  geom_ribbon(aes(ymin = mean_power - sd_power, ymax = mean_power + sd_power), 
              alpha = 0.15, color = NA) +
  geom_line(linewidth = 1) +
  geom_point(size = 1.5) + 
  scale_color_manual(values = colors_paper) +
  scale_fill_manual(values = colors_paper) +
  labs(x = "FDP", y = "Power") +
  theme_minimal()

# Assemblage Final
ggarrange(g_hist, g_main, ncol = 1, heights = c(1, 2), 
          common.legend = TRUE, legend = "right", align = "v")
